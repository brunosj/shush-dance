{
  "name": "shush",
  "description": "shush dance",
  "version": "3.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "serve": "cross-env NODE_OPTIONS=--no-deprecation PORT=3000 next start",
    "serve-green": "cross-env NODE_OPTIONS=--no-deprecation PORT=3001 next start",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:graphQLSchema": "cross-env NODE_OPTIONS=--no-deprecation payload generate:graphQLSchema",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,mjs}\" \"scripts/**/*.{ts,js,mjs}\" \"*.{ts,js,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,mjs}\" \"scripts/**/*.{ts,js,mjs}\" \"*.{ts,js,mjs,json}\"",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "export:events": "node scripts/exportEvents.cjs ./events.json",
    "export:products": "node scripts/exportProducts.cjs ./products.json",
    "migrate:event-ticket-tiers": "cross-env NODE_OPTIONS=--no-deprecation payload run ./scripts/migrateEventTicketTiers.ts",
    "backfill:stripe-fees": "cross-env NODE_OPTIONS=--no-deprecation payload run ./scripts/backfillStripeFees.cjs",
    "test:order-processing": "ts-node scripts/testOrderProcessing.ts",
    "test:order-validation": "ts-node scripts/testOrderValidation.ts",
    "test:tax": "ts-node scripts/testTaxUtilities.ts",
    "fix:media-urls": "cross-env NODE_OPTIONS=--no-deprecation payload run ./scripts/fixMediaUrls.ts --dry-run",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:slate-to-lexical": "cross-env NODE_OPTIONS=--no-deprecation payload run ./scripts/migrateSlateToLexical.ts",
    "backfill:blur": "cross-env NODE_OPTIONS=--no-deprecation payload run ./scripts/backfillBlurDataURL.ts"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.94.1",
    "@payloadcms/email-nodemailer": "3.94.1",
    "@payloadcms/live-preview-react": "3.94.1",
    "@payloadcms/next": "3.94.1",
    "@payloadcms/richtext-lexical": "3.94.1",
    "@payloadcms/ui": "3.94.1",
    "@paypal/react-paypal-js": "^8.9.2",
    "@stripe/react-stripe-js": "^3.10.0",
    "@stripe/stripe-js": "^4.10.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "escape-html": "^1.0.3",
    "graphql": "^16.12.0",
    "hamburger-react": "^2.5.2",
    "lodash": "^4.17.21",
    "music-metadata": "^10.9.1",
    "next": "16.4.6",
    "nodemailer": "^7.0.10",
    "payload": "3.94.1",
    "plaiceholder": "^3.0.0",
    "qs": "6.13.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-h5-audio-player": "^3.10.1",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "sharp": "0.35.4",
    "stripe": "^18.5.0",
    "use-shopping-cart": "^3.2.0",
    "xlsx": "^0.18.5",
    "yet-another-react-lightbox": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@swc/core": "1.7.36",
    "@types/escape-html": "^1.0.4",
    "@types/node": "22.19.9",
    "@types/qs": "^6.14.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.10.43",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-filenames": "^1.3.2",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.12.4+sha512.5ea8b0deed94ed68691c9bad4c955492705c5eeb8a87ef86bc62c74a26b037b08ff9570f108b2e4dbd1dd1a9186fea925e527f141c648e85af45631074680184"
}